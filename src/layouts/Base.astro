---
import '../styles/global.css';
import GameHud from '../components/game/GameHud';
import AuthBar from '../components/auth/AuthBar';
import Companion from '../components/game/Companion';
import SponsorBanner from '../components/SponsorBanner';
import ErrorBoundary from '../components/ErrorBoundary';
import BugReportModal from '../components/BugReportModal';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'Free, hands-on networking courses built around how ISPs actually run networks: IP, MikroTik, BGP and more.',
  noindex = false,
} = Astro.props;

const fullTitle = title === 'Network Academy' ? title : `${title} | Network Academy`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const links = [
  { href: '/play', label: 'Play' },
  { href: '/practice', label: 'Practice' },
  { href: '/learn', label: 'Learn' },
  { href: '/tools', label: 'Tools' },
  { href: '/community', label: 'Community' },
];
const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(href + '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0e2a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Network Academy" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      try {
        var t = localStorage.getItem('na-theme');
        var dark = t ? t === 'dark' : true;
        document.documentElement.classList.toggle('dark', dark);
      } catch (e) {}
    </script>
    <script>
      import { initSentry, captureError, addBreadcrumb } from '../scripts/sentry';
      import { installFetchWrapper } from '../scripts/sentry-fetch';
      import { initAnalytics } from '../scripts/analytics';
      initSentry().catch(e => console.error('Sentry init failed:', e));
      installFetchWrapper();
      initAnalytics();

      // Capture unhandled errors
      window.addEventListener('error', (event) => {
        captureError(event.error || new Error(event.message), {
          filename: event.filename,
          lineno: event.lineno,
          colno: event.colno,
        });
      });

      // Capture unhandled promise rejections
      window.addEventListener('unhandledrejection', (event) => {
        captureError(event.reason || new Error('Unhandled promise rejection'));
      });

      // Track navigation
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('a[href]');
        if (target instanceof HTMLAnchorElement && target.href.startsWith(window.location.origin)) {
          addBreadcrumb(`Navigating to ${target.pathname}`, 'navigation');
        }
      }, true);
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-bg font-sans text-fg antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg">Skip to content</a>

    <div class="ambient" aria-hidden="true"><i style="left:32%;animation-duration:23s;animation-delay:-3s"></i><i style="left:94%;animation-duration:26s;animation-delay:-15s"></i><i style="left:21%;animation-duration:16s;animation-delay:-2s"></i><i style="left:4%;animation-duration:26s;animation-delay:-17s"></i><i style="left:39%;animation-duration:15s;animation-delay:-7s"></i><i style="left:68%;animation-duration:25s;animation-delay:-8s"></i><i style="left:24%;animation-duration:17s;animation-delay:-8s"></i><i style="left:29%;animation-duration:14s;animation-delay:-26s"></i><i style="left:84%;animation-duration:22s;animation-delay:-25s"></i><i style="left:36%;animation-duration:20s;animation-delay:-5s"></i><i style="left:41%;animation-duration:23s;animation-delay:-20s"></i><i style="left:95%;animation-duration:25s;animation-delay:-2s"></i><i style="left:79%;animation-duration:24s;animation-delay:-21s"></i><i style="left:51%;animation-duration:30s;animation-delay:-7s"></i><i style="left:24%;animation-duration:21s;animation-delay:-15s"></i><i style="left:37%;animation-duration:16s;animation-delay:-30s"></i></div>

    <header class="site-header sticky top-0 z-40 border-b border-line bg-bg/95 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="pixel flex items-center gap-2 text-[0.7rem] leading-tight">
          <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="var(--accent)"/><g stroke="var(--accent-fg)" stroke-width="2.4" stroke-linecap="round" fill="none"><path d="M16 9v14M9 16h14"/></g><g fill="var(--accent-fg)"><circle cx="16" cy="9" r="2.6"/><circle cx="16" cy="23" r="2.6"/><circle cx="9" cy="16" r="2.6"/><circle cx="23" cy="16" r="2.6"/></g></svg>
          Network<span class="text-accent">Academy</span>
        </a>
        <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
          {links.map((l) => (
            <a href={l.href} aria-current={active(l.href) ? 'page' : undefined}
               class:list={['rounded-md px-3 py-1.5 text-sm hover:bg-surface-2', active(l.href) ? 'text-accent font-medium' : 'text-muted hover:text-fg']}>{l.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-1 sm:gap-2">
          <GameHud client:load />
          <AuthBar client:load />
          <button id="theme-toggle" type="button" aria-label="Toggle dark mode" class="rounded-md p-2.5 text-muted hover:bg-surface-2 hover:text-fg md:p-2 min-h-11 md:min-h-auto">
            <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="block dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
          <button id="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav" class="rounded-md p-2.5 text-muted hover:bg-surface-2 hover:text-fg md:p-2 min-h-11 md:min-h-auto md:hidden">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" aria-label="Mobile" hidden class="border-t border-line px-4 py-1 md:hidden">
        {links.map((l) => (
          <a href={l.href} class="block rounded-md px-3 py-2.5 text-sm hover:bg-surface-2 min-h-11">{l.label}</a>
        ))}
      </nav>
    </header>

    <SponsorBanner client:load />

    <main id="main" class="flex-1"><slot /></main>

    <footer class="mt-16 border-t border-line">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm sm:grid-cols-3 sm:px-6">
        <div>
          <p class="font-semibold">Network Academy</p>
          <p class="mt-2 max-w-xs text-muted">Free networking education, taught the way ISPs actually build networks.</p>
          <p class="mt-3 text-muted">Developed by <a class="font-semibold text-fg hover:text-accent" href="/about#pkt">PKT</a> (Pocket)</p>
        </div>
        <div>
          <p class="font-semibold">Learn</p>
          <ul class="mt-2 space-y-1.5 text-muted">
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/play">Play the game</a></li>
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/practice">Practice</a></li>
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/reference">Command and port reference</a></li>
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/learn">All courses</a></li>
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/roadmap">Roadmap</a></li>
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/sources">Sources</a></li>
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/sponsors">Sponsors</a></li>
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/community">Community</a></li>
            <li><BugReportModal client:load /></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold">Tools</p>
          <ul class="mt-2 space-y-1.5 text-muted">
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/tools/bgp-lab">BGP lab</a></li>
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/tools/stp-lab">Spanning tree lab</a></li>
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/tools/vlan-designer">VLAN designer</a></li>
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/tools/subnet-trainer">Subnetting trainer</a></li>
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/tools/subnet-calculator">Subnet calculator</a></li>
            <li><a class="block px-1 py-0.5 hover:text-fg" href="/tools/mikrotik-config-generator">MikroTik config generator</a></li>
          </ul>
        </div>
      </div>
      <p class="border-t border-line py-4 text-center text-xs text-muted">© {new Date().getFullYear()} Network Academy · <a class="hover:text-fg" href="/about">About</a> · <a class="hover:text-fg" href="/contact">Contact</a> · <a class="hover:text-fg" href="/privacy">Privacy</a> · <a class="hover:text-fg" href="/terms">Terms</a> · <a class="hover:text-fg" href="/disclaimer">Disclaimer</a> · Configs are provided as-is; test before production use.</p>
    </footer>

    <Companion client:idle />

    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = root.classList.toggle('dark');
        try { localStorage.setItem('na-theme', dark ? 'dark' : 'light'); } catch {}
      });
      const btn = document.getElementById('menu-toggle');
      const nav = document.getElementById('mobile-nav');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        if (nav) nav.hidden = open;
      });
    </script>
  </body>
</html>
