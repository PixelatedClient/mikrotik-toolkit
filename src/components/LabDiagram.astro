---
import type { Lab } from '../data/labs';
interface Props { lab: Lab }
const { lab } = Astro.props;
const at = (id: string) => lab.nodes.find((n) => n.id === id)!;
const short = (i: string) => i.replace(/^ether/, 'e').replace(/^sfp-sfpplus/, 's');
// a point `d` pixels from node `from` towards node `to`
const toward = (from: { x: number; y: number }, to: { x: number; y: number }, d: number) => {
  const dx = to.x - from.x, dy = to.y - from.y, len = Math.hypot(dx, dy) || 1;
  return { x: from.x + (dx / len) * d, y: from.y + (dy / len) * d };
};
const desc = `Topology of ${lab.title}: ` + lab.links.map((l) => `${l.a} ${l.ai} to ${l.b} ${l.bi}`).join('; ');
---
<svg viewBox="0 0 640 260" role="img" aria-label={desc} class="h-auto w-full">
  {lab.links.map((l) => {
    const a = at(l.a), b = at(l.b);
    const ma = toward(a, b, 42), mb = toward(b, a, 42);
    // links to a PC: hang the label under the PC so it never crowds the router
    const pcEnd = a.kind === 'pc' ? a : b.kind === 'pc' ? b : null;
    const mid = pcEnd ? { x: pcEnd.x, y: pcEnd.y > 160 ? pcEnd.y - 26 : pcEnd.y + 36 } : { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 - 0 };
    const trunk = l.net?.startsWith('trunk');
    return (
      <g>
        <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class={trunk ? 'stroke-accent' : 'stroke-muted'} stroke-width={trunk ? 4 : 2} />
        <text x={ma.x} y={ma.y} text-anchor="middle" dominant-baseline="middle" class="fill-muted text-[10px]" paint-order="stroke" stroke="var(--surface)" stroke-width="4">{short(l.ai)}</text>
        <text x={mb.x} y={mb.y} text-anchor="middle" dominant-baseline="middle" class="fill-muted text-[10px]" paint-order="stroke" stroke="var(--surface)" stroke-width="4">{short(l.bi)}</text>
        {l.net && <text x={mid.x} y={pcEnd ? mid.y : mid.y - 9} text-anchor="middle" class="fill-fg text-[10px]" paint-order="stroke" stroke="var(--surface)" stroke-width="4">{l.net}</text>}
      </g>
    );
  })}
  {lab.nodes.map((n) => (
    <g>
      {n.kind === 'router' && <circle cx={n.x} cy={n.y} r="26" class="fill-accent-soft stroke-accent" stroke-width="2.5" />}
      {n.kind === 'switch' && <rect x={n.x - 30} y={n.y - 20} width="60" height="40" rx="8" class="fill-accent-soft stroke-accent" stroke-width="2.5" />}
      {n.kind === 'pc' && <rect x={n.x - 22} y={n.y - 15} width="44" height="30" rx="5" class="fill-surface-2 stroke-line" stroke-width="2" />}
      <text x={n.x} y={n.y} text-anchor="middle" dominant-baseline="middle" class:list={['fill-fg font-semibold', n.kind === 'pc' ? 'text-[11px]' : n.label.length > 5 ? 'text-[10px]' : 'text-[12px]']}>{n.label}</text>
    </g>
  ))}
</svg>
