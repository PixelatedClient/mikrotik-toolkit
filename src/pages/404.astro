---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">No route to host</h1>
    <p class="mt-3 text-muted">That page doesn't exist or has moved.</p>
    <a href="/" class="mt-6 inline-block rounded-md bg-accent px-5 py-2.5 font-medium text-accent-fg">Back home</a>
  </div>
</Base>
