---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import LabDiagram from '../../components/LabDiagram.astro';
import LabChecklist from '../../components/LabChecklist';
import { LABS } from '../../data/labs';
import { lessonForGns3Lab } from '../../data/lessonKit';

export function getStaticPaths() {
  return LABS.map((lab, i) => ({ params: { id: lab.id }, props: { lab, next: LABS[i + 1] } }));
}
const { lab, next } = Astro.props;
const files = lab.nodes.filter((n) => n.file).map((n) => ({
  node: n.id,
  file: n.file!,
  href: `/labs/${lab.id}/${n.file}`,
  text: readFileSync(join(process.cwd(), 'public/labs', lab.id, n.file!), 'utf8').replace(/\r\n/g, '\n'),
}));
const tone = { Beginner: 'bg-accent-soft text-accent', Intermediate: 'bg-amber-500/15 text-amber-900 dark:text-amber-300', Advanced: 'bg-rose-500/15 text-rose-900 dark:text-rose-300' } as const;
const h2 = 'text-2xl font-bold tracking-tight';
const lessonId = lessonForGns3Lab(lab.id);
---
<Base title={lab.title} description={lab.summary}>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-sm text-muted"><a href="/learn" class="hover:text-fg">Learn</a>{lessonId && <> / <a href={`/learn/${lessonId}#lab`} class="hover:text-fg">Lesson lab</a></>} / GNS3: {lab.title}</nav>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <h1 class="text-4xl font-bold tracking-tight">{lab.title}</h1>
      <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium', tone[lab.level]]}>{lab.level}</span>
      <span class="text-sm text-muted">{lab.minutes} min</span>
    </div>
    <p class="mt-3 max-w-2xl text-muted">{lab.summary}</p>

    <p class="mt-4 max-w-2xl rounded-lg border border-line bg-surface p-3 text-sm">
      This page is for running the lab on <strong>real MikroTik routers in GNS3</strong>.
      {lessonId ? <> The lab you can run in your browser lives inside its lesson: <a class="text-accent underline" href={`/learn/${lessonId}#lab`}>open the lesson lab</a>.</> : <> This lab needs real routers for now: OSPF, BGP and WireGuard are not in the browser simulator yet.</>}
    </p>

    <h2 class={`${h2} mt-10`}>What you will learn</h2>
    <ul class="mt-3 list-disc space-y-1 pl-5 text-sm">
      {lab.objectives.map((o) => <li>{o}</li>)}
    </ul>

    <h2 class={`${h2} mt-10`}>Topology</h2>
    <div class="mt-3 rounded-xl border border-line bg-surface p-3"><LabDiagram lab={lab} /></div>
    <div class="mt-4 overflow-x-auto rounded-xl border border-line">
      <table class="min-w-full text-sm">
        <caption class="sr-only">GNS3 wiring</caption>
        <thead class="bg-surface-2 text-left text-xs text-muted"><tr><th scope="col" class="px-3 py-2">Cable from</th><th scope="col" class="px-3 py-2">to</th><th scope="col" class="px-3 py-2">Network</th></tr></thead>
        <tbody>
          {lab.links.map((l) => (
            <tr class="border-t border-line">
              <td class="px-3 py-2 font-mono text-xs">{l.a}.{l.ai}</td>
              <td class="px-3 py-2 font-mono text-xs">{l.b}.{l.bi}</td>
              <td class="px-3 py-2 text-muted">{l.net ?? ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class={`${h2} mt-10`}>Set up</h2>
    <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-sm">
      {lab.setup.map((s) => <li>{s}</li>)}
    </ol>

    <h2 class={`${h2} mt-10`}>Router configurations</h2>
    <p class="mt-2 text-sm text-muted">Download each file, or open it here and paste it into the router console. These are RouterOS v7 scripts.</p>
    <ul class="mt-3 flex flex-wrap gap-2" aria-label="Download configurations">
      {files.map((f) => (
        <li><a href={f.href} download class="inline-block rounded-md border border-line px-3 py-1.5 font-mono text-sm hover:border-accent">{f.file}</a></li>
      ))}
    </ul>
    <div class="mt-3 space-y-2">
      {files.map((f) => (
        <details class="rounded-xl border border-line bg-surface">
          <summary class="cursor-pointer px-4 py-2.5 text-sm"><span class="font-mono font-medium">View {f.file}</span></summary>
          <pre class="max-h-96 overflow-auto border-t border-line p-4 font-mono text-xs leading-relaxed" tabindex="0"><code>{f.text}</code></pre>
        </details>
      ))}
    </div>

    <h2 class={`${h2} mt-10`}>Your tasks</h2>
    <div class="mt-3 rounded-xl border border-line bg-surface p-4"><LabChecklist client:load labId={lab.id} tasks={lab.tasks} /></div>

    <h2 class={`${h2} mt-10`}>Check your work</h2>
    <p class="mt-2 text-sm text-muted">Run these on the router shown and compare with what you should see.</p>
    <div class="mt-3 space-y-3">
      {lab.verify.map((v) => (
        <div class="rounded-xl border border-line bg-surface p-4">
          <p class="flex items-center gap-2 text-sm font-medium"><span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-xs">{v.node}</span>{v.title}</p>
          <pre class="mt-2 overflow-auto rounded-lg border border-line bg-bg p-3 font-mono text-xs" tabindex="0"><code>{v.cmd}</code></pre>
          <p class="mt-2 text-sm text-muted"><span class="font-medium text-fg">Expect:</span> {v.expect}</p>
        </div>
      ))}
    </div>

    <h2 class={`${h2} mt-10`}>Related</h2>
    <ul class="mt-3 space-y-1 text-sm">
      {lab.related.map((r) => <li><a class="text-accent underline" href={r.href}>{r.label}</a></li>)}
    </ul>
    {next && (
      <a href={`/labs/${next.id}`} class="mt-10 block rounded-xl border border-line p-4 hover:border-accent">
        <span class="text-xs text-muted">Next lab →</span>
        <span class="block font-medium">{next.title}</span>
      </a>
    )}
  </div>
</Base>
