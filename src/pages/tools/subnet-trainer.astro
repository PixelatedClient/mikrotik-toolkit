---
import Base from '../../layouts/Base.astro';
import SubnetTrainer from '../../components/SubnetTrainer';
---
<Base title="Subnetting Trainer" description="Practice subnetting with instant feedback and worked solutions. Three levels, ten questions a round.">
  <div class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
    <h1 class="text-4xl font-bold tracking-tight">Subnetting trainer</h1>
    <p class="mt-2 text-muted">Ten questions a round. Every wrong answer shows the working, so you learn the trick, not just the result.</p>
    <SubnetTrainer client:load />
    <p class="text-sm text-muted">Stuck? Read <a class="text-accent underline" href="/learn/foundations/02-ip-addressing-subnetting">IP addresses &amp; subnetting</a> or check answers with the <a class="text-accent underline" href="/tools/subnet-calculator">calculator</a>.</p>
  </div>
</Base>
