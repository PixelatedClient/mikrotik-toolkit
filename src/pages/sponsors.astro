---
import Base from '../layouts/Base.astro';
import AffiliateLinks from '../components/AffiliateLinks';
import NewsletterSignup from '../components/NewsletterSignup';
import { getAffiliatesByCategory } from '../data/affiliates';

const hardware = getAffiliatesByCategory('hardware');
const hosting = getAffiliatesByCategory('hosting');
const tools = getAffiliatesByCategory('tools');
const learning = getAffiliatesByCategory('learning');
---
<Base title="Sponsors & Partnerships" description="Support Network Academy through partnerships and affiliate links. We partner with tools and services we use and recommend.">
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="text-4xl font-bold tracking-tight">Sponsors & Partnerships</h1>
    <div class="prose prose-neutral mt-6 dark:prose-invert max-w-none">
      <p>
        Network Academy is free and always will be. We're sustained by partnerships with tools, services, and platforms that network engineers use every day.
      </p>

      <h2>How it works</h2>
      <p>
        When you click an affiliate link below and make a purchase, Network Academy earns a small commission at no extra cost to you. This helps us:
      </p>
      <ul>
        <li>Pay for hosting and infrastructure</li>
        <li>Maintain course content and keep lessons up to date with RouterOS releases</li>
        <li>Add new labs and interactive tools</li>
        <li>Keep the site free for everyone</li>
      </ul>

      <h2>Our partners</h2>
      <p>
        We only partner with tools and services we recommend and use ourselves. If it's on this list, we believe it's worth your time.
      </p>
    </div>

    <section aria-labelledby="hardware-partners" class="mt-8">
      <h2 id="hardware-partners" class="text-2xl font-bold mb-4">Networking Hardware</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {hardware.map((partner) => (
          <div class="rounded-lg border border-line bg-surface p-4">
            <h3 class="font-semibold text-fg mb-2">{partner.name}</h3>
            <p class="text-sm text-muted mb-3">{partner.description}</p>
            <a
              href={partner.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block text-sm font-medium text-accent hover:underline"
            >
              Learn more →
            </a>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="hosting-partners" class="mt-8">
      <h2 id="hosting-partners" class="text-2xl font-bold mb-4">Hosting & Cloud</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {hosting.map((partner) => (
          <div class="rounded-lg border border-line bg-surface p-4">
            <h3 class="font-semibold text-fg mb-2">{partner.name}</h3>
            <p class="text-sm text-muted mb-3">{partner.description}</p>
            <a
              href={partner.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block text-sm font-medium text-accent hover:underline"
            >
              Learn more →
            </a>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="tools-partners" class="mt-8">
      <h2 id="tools-partners" class="text-2xl font-bold mb-4">Tools & Utilities</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {tools.map((partner) => (
          <div class="rounded-lg border border-line bg-surface p-4">
            <h3 class="font-semibold text-fg mb-2">{partner.name}</h3>
            <p class="text-sm text-muted mb-3">{partner.description}</p>
            <a
              href={partner.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block text-sm font-medium text-accent hover:underline"
            >
              Learn more →
            </a>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="learning-partners" class="mt-8">
      <h2 id="learning-partners" class="text-2xl font-bold mb-4">Learning & Certification</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {learning.map((partner) => (
          <div class="rounded-lg border border-line bg-surface p-4">
            <h3 class="font-semibold text-fg mb-2">{partner.name}</h3>
            <p class="text-sm text-muted mb-3">{partner.description}</p>
            <a
              href={partner.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block text-sm font-medium text-accent hover:underline"
            >
              Learn more →
            </a>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="direct-support" class="mt-12">
      <h2 id="direct-support" class="text-2xl font-bold mb-4">Support directly</h2>
      <p class="text-muted mb-6">
        Prefer to support Network Academy directly? Choose how you'd like to help:
      </p>
      <div class="grid gap-6 md:grid-cols-2 mb-8">
        <div class="rounded-lg border border-line bg-surface p-6">
          <div class="flex items-start gap-3 mb-3">
            <div class="text-2xl">❤️</div>
            <div>
              <h3 class="font-semibold text-fg text-lg">Become a Patron</h3>
              <p class="text-sm text-muted mt-1">Recurring support at any level</p>
            </div>
          </div>
          <p class="text-sm text-muted mb-4">
            Join us on Patreon for early access to new content, direct input on what we build next, and the knowledge that you're keeping Network Academy free for everyone.
          </p>
          <a
            href="https://patreon.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-sm font-medium text-accent hover:underline"
          >
            Support on Patreon →
          </a>
        </div>

        <div class="rounded-lg border border-line bg-surface p-6">
          <div class="flex items-start gap-3 mb-3">
            <div class="text-2xl">🌟</div>
            <div>
              <h3 class="font-semibold text-fg text-lg">GitHub Sponsors</h3>
              <p class="text-sm text-muted mt-1">One-time or monthly</p>
            </div>
          </div>
          <p class="text-sm text-muted mb-4">
            Sponsor us on GitHub with a one-time gift or monthly recurring support. Every dollar goes toward hosting, content, and tools.
          </p>
          <a
            href="https://github.com/sponsors"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-sm font-medium text-accent hover:underline"
          >
            Sponsor on GitHub →
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="newsletter" class="mt-12 rounded-lg border border-line bg-surface p-6">
      <h2 id="newsletter" class="text-xl font-bold mb-3">Stay updated</h2>
      <p class="text-sm text-muted mb-4">
        Get notified when we release new lessons, labs, and tools. Unsubscribe anytime.
      </p>
      <NewsletterSignup client:load />
    </section>

    <div class="prose prose-neutral mt-12 dark:prose-invert max-w-none">
      <h2>Become a partner</h2>
      <p>
        If you operate a tool, service, or platform that network engineers use, we'd love to work with you. Email us at <a href="mailto:partners@networkacademy.example">partners@networkacademy.example</a> to discuss partnership opportunities.
      </p>

      <h2>Affiliate disclosure</h2>
      <p>
        Network Academy is part of affiliate programs for the products listed on this page. When you click a link and make a purchase, we earn a commission. This does not affect the price you pay. We only recommend products and services we genuinely believe in and use ourselves.
      </p>
    </div>
  </div>
</Base>
